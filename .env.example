# 환경설정 예시. 복사해서 .env로 쓰고 값을 채운다. .env는 절대 커밋하지 않는다.
HOGI_BASE=~/hogi-chat
HOGI_ENV=~/hogi-chat/.env

# 방송 채널
HOGI_BJ_ID=
HOGI_BJ_NAME=
HOGI_BJ_NICKS=

# 내 계정(전송·사칭 판정 기준). 닉네임은 쉼표로 구분
HOGI_SELF_IDS=
HOGI_SELF_NICKS=
HOGI_SELF_DISPLAY=

# 운영자 표시 이름 (프롬프트에 쓰임)
HOGI_OWNER_NAME=운영자

# Discord
HOGI_CHANNEL_ID=
HOGI_OWNER_DISCORD_ID=
DISCORD_BOT_TOKEN=
DISCORD_HOGI_BOT_TOKEN=
DISCORD_HOGI_PUBLIC_KEY=
DISCORD_OWNER_ID=

# 모델
OPENROUTER_API_KEY=
OPENAI_API_KEY=
HOGI_MODEL=anthropic/claude-opus-5-5
HOGI_JUDGE_MODEL=anthropic/claude-opus-5.5
HOGI_JUDGE_MIN=7
HOGI_MODE=rag

# 전사
HOGI_LIVE_STT_MODEL=gpt-live-transcribe
HOGI_LIVE_STT_DELAY=medium
HOGI_LIVE_STT_PRICE=0.017
HOGI_VAD_DB=-38
HOGI_STT_CAP_USD=30
HOGI_STT_KEYWORDS=

# 생성 트리거
HOGI_TRIGGER_MIN_GAP=30
HOGI_TRIGGER_IDLE=90

# 데이터 보관 (아카이브 분석용)
HOGI_ARCHIVE_PREFIX=
HOGI_R2_BUCKET=
